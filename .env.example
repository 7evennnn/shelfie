# Required for Google Books search. Restrict this browser key to the Books API
# and the site origins that should be allowed to use it.
VITE_GOOGLE_BOOKS_API_KEY=

# Optional. Used only for aggregate community counters.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional. Proxies Google Books cover images when creating share images.
VITE_IMAGE_PROXY_URL=

# Optional. Google Books requests work without a key, but a restricted browser key
# can provide a more predictable quota.
VITE_GOOGLE_BOOKS_API_KEY=

# Optional. Used only for aggregate community counters.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional. Proxies Google Books cover images when creating share images.
VITE_IMAGE_PROXY_URL=
